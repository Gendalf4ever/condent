rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Функция для проверки администратора
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email in [
          'admin@codent.pro',
          'chelovek438@gmail.com'
        ];
    }
    
    // Функция для проверки авторизации
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Правила для коллекции пользователей
    match /users/{userId} {
      // Пользователи могут читать и изменять только свои данные
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Создание документа пользователя при регистрации
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Правила для коллекции отзывов
    match /reviews/{reviewId} {
      // Все могут читать одобренные отзывы
      allow read: if resource.data.status == 'approved';
      
      // Пользователи могут читать свои отзывы (любого статуса)
      allow read: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
      
      // Авторизованные пользователи могут создавать отзывы
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending';
      
      // Пользователи могут редактировать и удалять только свои отзывы
      allow update, delete: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
      
      // Админы могут читать все отзывы и изменять их статус
      allow read, write: if isAdmin();
    }
    
    // Правила для коллекции вопросов о товарах
    match /questions/{questionId} {
      // Все могут читать одобренные вопросы
      allow read: if resource.data.status == 'approved';
      
      // Пользователи могут читать свои вопросы (любого статуса)
      allow read: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
      
      // Авторизованные пользователи могут создавать вопросы
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending';
      
      // Пользователи могут редактировать и удалять только свои вопросы
      allow update, delete: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
      
      // Админы могут читать все вопросы и изменять их статус
      allow read, write: if isAdmin();
      
      // Правила для подколлекции ответов
      match /answers/{answerId} {
        // Все могут читать ответы на одобренные вопросы
        allow read: if get(/databases/$(database)/documents/questions/$(questionId)).data.status == 'approved';
        
        // Только админы могут создавать и изменять ответы
        allow create, update, delete: if isAdmin();
      }
    }
    
    // Правила для коллекции статей (блог)
    match /articles/{articleId} {
      // Все могут читать статьи
      allow read: if true;
      
      // Только админы могут создавать, изменять и удалять статьи
      allow write: if isAdmin();
    }
    
    // Правила для коллекции товаров
    match /products/{productId} {
      // Все могут читать товары
      allow read: if true;
      
      // Только админы могут создавать, изменять и удалять товары
      allow write: if isAdmin();
    }
    
    // Правила для коллекции админов
    match /admins/{adminId} {
      // Только админы могут читать список админов
      allow read: if isAdmin();
    }
    
    // Запрещаем доступ ко всем остальным коллекциям
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
